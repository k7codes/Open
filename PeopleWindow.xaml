<Window x:Class="OpenFaceRegistry.PeopleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kişi kayıtları" Height="700" Width="1040" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI" Foreground="#172033">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock Text="Kişi kayıtları" FontSize="24" FontWeight="Bold"/><TextBlock Text="Kayıt ekle, bilgileri düzenle ve örnek fotoğrafları yönet." Foreground="#667085" Margin="0,4,0,0"/></StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12" BorderBrush="#E5E8F0" BorderThickness="1">
                <DataGrid x:Name="PeopleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="PeopleGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="Fotoğraf" Binding="{Binding SampleCount}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18" BorderBrush="#E5E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="Yeni kişi" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <TextBlock Text="Ad Soyad *"/><TextBox x:Name="NameBox" Margin="0,5,0,12"/>
                        <TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Margin="0,5,0,12"/>
                        <TextBlock Text="E-posta"/><TextBox x:Name="EmailBox" Margin="0,5,0,12"/>
                        <TextBlock Text="Notlar"/><TextBox x:Name="NotesBox" Margin="0,5,0,14" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <StackPanel><TextBlock x:Name="SampleLabel" Text="Yeni kişi için en az 2 örnek fotoğraf ekle." FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Fotoğrafta aynı kişinin yüzü net görünmeli." Foreground="#667085" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <WrapPanel>
                            <Button Content="Yeni" Click="New_Click"/>
                            <Button Content="Fotoğraf ekle ve kaydet" Background="#4F46E5" Foreground="White" Margin="8,0,0,0" Click="Save_Click"/>
                            <Button Content="Sil" Margin="8,0,0,0" Click="Delete_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
